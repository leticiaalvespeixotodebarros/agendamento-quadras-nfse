# Copie para .env (ou defina as variáveis no servidor). NUNCA grave senhas/chaves no código.

# --- IA (sem esta chave, o assistente usa o roteiro por menu) ---
ANTHROPIC_API_KEY=
# QUADRAS_MODELO=claude-haiku-5-5

# --- Painel ---
# ADMIN_PASSWORD=troque-esta-senha        # usuário: admin
# PAINEL_URL=https://painel.exemplo.com.br

# --- WhatsApp Cloud API (Meta) — só quando o número oficial estiver aprovado ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_VERIFY_TOKEN=uma-frase-secreta-qualquer
# WHATSAPP_APP_SECRET=

# --- E-mail do lembrete semanal ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Emissão fiscal: simulado (padrão) | nacional (a implementar após fechar) ---
# QUADRAS_EMISSOR=simulado
